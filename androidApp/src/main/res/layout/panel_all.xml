<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/expense_list_title"
        android:textSize="19sp"
        android:textColor="@color/text"
        android:textStyle="bold" />
    <Space
        android:layout_width="1dp"
        android:layout_height="7dp" />
    <TextView
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/expense_list_description"
        android:textSize="12sp"
        android:textColor="@color/muted" />
    <Space
        android:layout_width="1dp"
        android:layout_height="25dp" />
    <TextView
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_expenses"
        android:textSize="13sp"
        android:textColor="@color/muted"
        android:id="@+id/expensesEmpty" />
    <LinearLayout android:id="@+id/expenseRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
</LinearLayout>
