<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_title"
        android:textSize="38sp"
        android:textColor="@color/text"
        android:textStyle="bold"
        android:letterSpacing="-0.03" />

    <Space
        android:layout_width="1dp"
        android:layout_height="24dp" />

    <!-- Main Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp"
        android:elevation="2dp">

        <!-- Month & Year Top Right -->
        <TextView
            android:id="@+id/homeMonth"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/muted" />

        <Space
            android:layout_width="1dp"
            android:layout_height="16dp" />

        <!-- Central Prominent Display: Total Spent Amount with ILS symbol -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layoutDirection="ltr"
            android:gravity="center">

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="@string/ils_symbol"
                android:textColor="@color/muted"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/homeTotal"
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amount_zero"
                android:textColor="@color/text"
                android:textSize="58sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="6dp" />

        <TextView
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/monthly_total"
            android:textSize="14sp"
            android:textColor="@color/muted" />

        <Space
            android:layout_width="1dp"
            android:layout_height="20dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <!-- Clickable Remaining Budget Row: "נותר מהתקציב" and amount with chevron -->
        <LinearLayout
            android:id="@+id/homeBudgetArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <TextView
                style="@style/Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/remaining_budget"
                android:textSize="16sp"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeBudgetRemaining"
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textDirection="ltr"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/budgetChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_chevron_down"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Expandable Budget Breakdown Section -->
        <LinearLayout
            android:id="@+id/budgetBreakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line"
                android:layout_marginBottom="14dp" />

            <!-- Total Budget for Month row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="10dp">

                <TextView
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/total_budget_for_month"
                    android:textSize="14sp"
                    android:textColor="@color/muted" />

                <TextView
                    android:id="@+id/homeBudgetTotal"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textDirection="ltr"
                    android:textColor="@color/muted" />
            </LinearLayout>

            <!-- Dynamic Source Rows or Empty State message -->
            <LinearLayout
                android:id="@+id/budgetBreakdownRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="140dp" />

    <!-- Add Expense Bottom Action Button -->
    <LinearLayout
        android:id="@+id/addExpense"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/button_primary"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <TextView
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_expense"
            android:textSize="17sp"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_plus"
            android:contentDescription="@null" />
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="24dp" />
</LinearLayout>
