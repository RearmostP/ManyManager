<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_intro"
        android:textSize="13sp"
        android:textColor="@color/muted" />
    <Space
        android:layout_width="1dp"
        android:layout_height="10dp" />
    <TextView
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_title"
        android:textSize="34sp"
        android:textColor="@color/text"
        android:textStyle="bold"
        android:letterSpacing="-0.03" />
    <Space
        android:layout_width="1dp"
        android:layout_height="28dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card"
        android:padding="24dp"
        android:elevation="2dp">
        <TextView
            android:id="@+id/homeMonth"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/muted" />
        <com.example.manymanager.BudgetOverviewLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/monthly_total"
                    android:minLines="2"
                    android:textSize="13sp"
                    android:textColor="@color/muted" />
                <TextView
                    android:id="@+id/homeTotal"
                    style="@style/Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/amount_zero"
                    android:textSize="34sp"
                    android:textDirection="ltr"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/homeEmpty"
                    style="@style/Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/no_expenses"
                    android:textSize="12sp"
                    android:textColor="@color/muted" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/homeBudgetArea"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <TextView
                    style="@style/Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/remaining_budget"
                    android:minLines="2"
                    android:textSize="13sp"
                    android:textColor="@color/muted" />
                <TextView
                    android:id="@+id/homeBudgetRemaining"
                    style="@style/Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="34sp"
                    android:textDirection="ltr"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/homeBudgetTotal"
                    style="@style/Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="12sp"
                    android:textColor="@color/muted" />
            </LinearLayout>
        </com.example.manymanager.BudgetOverviewLayout>
        <ScrollView
            android:id="@+id/budgetBreakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/chip"
            android:padding="16dp"
            android:visibility="gone"
            android:nestedScrollingEnabled="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    style="@style/Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/budget_by_source"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:accessibilityHeading="true" />
                <LinearLayout
                    android:id="@+id/budgetBreakdownRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <Space
        android:layout_width="1dp"
        android:layout_height="175dp" />
    <TextView
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_expense"
        android:textSize="17sp"
        android:textColor="@color/white"
        android:id="@+id/addExpense"
        android:gravity="center"
        android:textStyle="bold"
        android:background="@drawable/primary"
        android:minHeight="58dp"
        android:padding="17dp"
        android:clickable="true"
        android:focusable="true" />
    <Space
        android:layout_width="1dp"
        android:layout_height="17dp" />
    <TextView
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_footer"
        android:textSize="12sp"
        android:textColor="@color/muted"
        android:gravity="center" />
</LinearLayout>
