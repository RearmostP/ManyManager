<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView android:id="@+id/expenseGroupBack" style="@style/Text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:padding="14dp" android:gravity="center_vertical"
        android:text="@string/back" android:textColor="@color/text"
        android:background="@drawable/button_secondary" android:clickable="true" android:focusable="true" />
    <TextView android:id="@+id/expenseGroupTitle" style="@style/Text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:textSize="26sp" android:textStyle="bold"
        android:textColor="@color/text" android:accessibilityHeading="true" />
    <TextView android:id="@+id/expenseGroupPeriod" style="@style/Text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textSize="14sp" android:textColor="@color/muted" />
    <TextView android:id="@+id/expenseGroupEmpty" style="@style/Text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:paddingTop="16dp" android:textSize="14sp"
        android:textColor="@color/muted" android:accessibilityLiveRegion="polite" />
    <LinearLayout android:id="@+id/expenseGroupRows"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
</LinearLayout>
