<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:minHeight="48dp"
    android:importantForAccessibility="yes" android:screenReaderFocusable="true">
    <View android:id="@+id/summaryExpenseDivider"
        android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/line" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="14dp" android:paddingBottom="14dp">
        <TextView android:id="@+id/summaryExpenseAmount" style="@style/Text"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text"
            android:includeFontPadding="false" android:lineHeight="24sp" android:importantForAccessibility="no" />
        <TextView android:id="@+id/summaryExpenseSecondary" style="@style/Text"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:textSize="12sp" android:textColor="@color/muted"
            android:includeFontPadding="false" android:lineHeight="18sp" android:importantForAccessibility="no" />
        <TextView android:id="@+id/summaryExpenseNote" style="@style/Text"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:textSize="13sp" android:textColor="@color/text"
            android:includeFontPadding="false" android:lineHeight="18sp"
            android:maxLines="2" android:ellipsize="end" android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
