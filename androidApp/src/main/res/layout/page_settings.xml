<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView style="@style/Text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/settings_intro" android:textSize="13sp" android:textColor="@color/muted" />
    <TextView style="@style/Text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="@string/settings" android:textSize="34sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/categoriesToggle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="28dp" android:minHeight="78dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="14dp"
        android:paddingBottom="14dp" android:clickable="true" android:focusable="true"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="16dp"
            android:src="@drawable/ic_category" app:tint="@color/muted" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/Text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/expense_categories" android:textSize="16sp" />
            <TextView android:id="@+id/settingsCategoriesSummary" style="@style/Text"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/no_categories"
                android:textSize="12sp" android:textColor="@color/muted" />
        </LinearLayout>
        <ImageView android:layout_width="15dp" android:layout_height="15dp"
            android:src="@drawable/ic_left" app:tint="@color/muted" android:importantForAccessibility="no" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="20dp" android:background="@color/line" />
    <TextView style="@style/Text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="25dp" android:text="@string/language_and_appearance"
        android:textSize="12sp" android:textColor="@color/muted" />
    <LinearLayout android:id="@+id/languageToggle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="78dp" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingTop="14dp" android:paddingBottom="14dp"
        android:clickable="true" android:focusable="true"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="16dp"
            android:src="@drawable/ic_language" app:tint="@color/muted" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/Text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/app_language" android:textSize="16sp" />
            <TextView android:id="@+id/languageLabel" style="@style/Text"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/language_he"
                android:textSize="12sp" android:textColor="@color/muted" />
        </LinearLayout>
        <ImageView android:id="@+id/languageChevron" android:layout_width="15dp"
            android:layout_height="15dp" android:src="@drawable/ic_left"
            app:tint="@color/muted" android:importantForAccessibility="no" />
    </LinearLayout>
    <com.example.manymanager.ChipFlowLayout android:id="@+id/languageDetails"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="40dp" android:paddingBottom="20dp" android:visibility="gone">
        <TextView android:id="@+id/languageHe" style="@style/Text" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center"
            android:text="@string/language_he" android:textSize="13sp" android:padding="11dp"
            android:background="@drawable/chip" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/languageEn" style="@style/Text" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center"
            android:text="@string/language_en" android:textSize="13sp" android:padding="11dp"
            android:background="@drawable/chip" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/languageRu" style="@style/Text" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center"
            android:text="@string/language_ru" android:textSize="13sp" android:padding="11dp"
            android:background="@drawable/chip" android:clickable="true" android:focusable="true" />
    </com.example.manymanager.ChipFlowLayout>
    <LinearLayout android:id="@+id/themeToggle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="78dp" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingTop="14dp" android:paddingBottom="14dp"
        android:clickable="true" android:focusable="true"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="16dp"
            android:src="@drawable/ic_theme" app:tint="@color/muted" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/Text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/app_appearance" android:textSize="16sp" />
            <TextView android:id="@+id/themeLabel" style="@style/Text"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/theme_light"
                android:textSize="12sp" android:textColor="@color/muted" />
        </LinearLayout>
        <ImageView android:id="@+id/themeChevron" android:layout_width="15dp"
            android:layout_height="15dp" android:src="@drawable/ic_left"
            app:tint="@color/muted" android:importantForAccessibility="no" />
    </LinearLayout>
    <com.example.manymanager.ChipFlowLayout android:id="@+id/themeDetails"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="40dp" android:paddingBottom="20dp" android:visibility="gone">
        <TextView android:id="@+id/lightTheme" style="@style/Text" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center"
            android:text="@string/theme_light" android:textSize="13sp" android:padding="11dp"
            android:background="@drawable/chip" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/darkTheme" style="@style/Text" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center"
            android:text="@string/theme_dark" android:textSize="13sp" android:padding="11dp"
            android:background="@drawable/chip" android:clickable="true" android:focusable="true" />
    </com.example.manymanager.ChipFlowLayout>
</LinearLayout>
