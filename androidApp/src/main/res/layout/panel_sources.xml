<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/payment_breakdown_title"
        android:textSize="19sp"
        android:textColor="@color/text"
        android:textStyle="bold" />
    <Space
        android:layout_width="1dp"
        android:layout_height="7dp" />
    <TextView
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/payment_breakdown_description"
        android:textSize="12sp"
        android:textColor="@color/muted" />
    <Space
        android:layout_width="1dp"
        android:layout_height="15dp" />
    <TextView
        android:id="@+id/sourceSummaryEmpty"
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_payment_methods"
        android:textSize="13sp"
        android:textColor="@color/muted" />
    <LinearLayout android:id="@+id/sourceSummaryRows"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    <Space
        android:layout_width="1dp"
        android:layout_height="19dp" />
    <TextView
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/payment_breakdown_explanation"
        android:textSize="12sp"
        android:textColor="@color/muted"
        android:lineSpacingMultiplier="1.3" />
</LinearLayout>
