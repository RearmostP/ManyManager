<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp">
    <TextView style="@style/Text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/edit_source" android:textSize="23sp" android:textStyle="bold" />
    <TextView android:id="@+id/editSourceMonth" style="@style/Text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="13sp" android:textColor="@color/muted" />
    <EditText android:id="@+id/editSourceName" style="@style/Text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:minHeight="48dp" android:padding="14dp"
        android:background="@drawable/chip" android:hint="@string/source_name"
        android:textColorHint="@color/muted"
        android:inputType="textCapSentences" android:singleLine="true" android:textSize="14sp" />
    <TextView android:id="@+id/currentSourceBudget" style="@style/Text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:textSize="14sp" />
    <TextView style="@style/Text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="@string/adjustment_amount" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
        <EditText android:id="@+id/sourceAdjustment" style="@style/Text"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:minHeight="48dp" android:padding="14dp" android:background="@drawable/chip"
            android:hint="@string/amount_zero" android:textColorHint="@color/muted"
            android:inputType="numberDecimal"
            android:singleLine="true" android:textDirection="ltr" android:textSize="20sp" />
        <TextView android:id="@+id/sourcePlus" style="@style/Text"
            android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp"
            android:gravity="center" android:text="+" android:textSize="20sp"
            android:contentDescription="@string/add_to_budget"
            android:background="@drawable/chip_active" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/sourceMinus" style="@style/Text"
            android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp"
            android:gravity="center" android:text="−" android:textSize="20sp"
            android:contentDescription="@string/deduct_from_budget"
            android:background="@drawable/chip" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <TextView android:id="@+id/sourcePreview" style="@style/Text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:textSize="16sp" android:textStyle="bold"
        android:accessibilityLiveRegion="polite" />
</LinearLayout>
