<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sheet"
    android:layoutDirection="locale"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="25dp">
        <FrameLayout
            android:id="@+id/expenseDragHandle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:importantForAccessibility="no">
            <View
                android:layout_width="36dp"
                android:layout_height="5dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/track" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="23dp">
            <TextView
                style="@style/Text"
                android:layout_height="wrap_content"
                android:text="@string/new_expense"
                android:textSize="23sp"
                android:textColor="@color/text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/closeDialog"
                style="@style/IconButton"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/close" />
        </LinearLayout>
        <TextView
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/expense_amount"
            android:textSize="14sp"
            android:textColor="@color/text"
            android:textStyle="bold" />
        <Space
            android:layout_width="1dp"
            android:layout_height="12dp" />
        <EditText
            android:id="@+id/amount"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="44sp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:hint="@string/amount_zero"
            android:gravity="start"
            android:textDirection="ltr"
            android:backgroundTint="@color/line"
            android:importantForAutofill="no" />
        <Space
            android:layout_width="1dp"
            android:layout_height="23dp" />
        <TextView
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/expense_category"
            android:textSize="14sp"
            android:textColor="@color/text"
            android:textStyle="bold" />
        <Space
            android:layout_width="1dp"
            android:layout_height="12dp" />
        <TextView
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_categories"
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:id="@+id/expenseCategoriesEmpty" />
        <LinearLayout android:id="@+id/expenseCategoryChoices"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <Space
            android:layout_width="1dp"
            android:layout_height="15dp" />
        <TextView
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_method"
            android:textSize="14sp"
            android:textColor="@color/text"
            android:textStyle="bold" />
        <Space
            android:layout_width="1dp"
            android:layout_height="12dp" />
        <TextView
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_payment_methods"
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:id="@+id/expensePaymentMethodsEmpty" />
        <LinearLayout android:id="@+id/expenseSourceChoices"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <Space
            android:layout_width="1dp"
            android:layout_height="15dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp">
                <TextView
                    style="@style/Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/expense_date"
                    android:textSize="14sp"
                    android:textColor="@color/text"
                    android:textStyle="bold" />
                <Space
                    android:layout_width="1dp"
                    android:layout_height="12dp" />
                <EditText
                    android:id="@+id/expenseDate"
                    android:textDirection="ltr"
                    style="@style/Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textSize="14sp"
                    android:background="@drawable/chip"
                    android:padding="14dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:inputType="date" />
            </LinearLayout>
            <LinearLayout
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp">
                <TextView
                    style="@style/Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/optional_note"
                    android:textSize="14sp"
                    android:textColor="@color/text"
                    android:textStyle="bold" />
                <Space
                    android:layout_width="1dp"
                    android:layout_height="12dp" />
                <EditText
                    android:id="@+id/expenseNote"
                    style="@style/Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textSize="14sp"
                    android:background="@drawable/chip"
                    android:padding="14dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:inputType="textMultiLine|textCapSentences"
                    android:hint="@string/expense_note_hint" />
            </LinearLayout>
        </LinearLayout>
        <Space
            android:layout_width="1dp"
            android:layout_height="23dp" />
        <TextView
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_expense"
            android:textSize="17sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:textStyle="bold"
            android:background="@drawable/primary"
            android:minHeight="58dp"
            android:padding="17dp"
            android:id="@+id/saveExpense"
            android:enabled="false"
            android:alpha="0.45" />
    </LinearLayout>
</ScrollView>
