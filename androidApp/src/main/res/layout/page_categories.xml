<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <ImageButton android:id="@+id/categoryBack" style="@style/IconButton"
        android:src="@drawable/ic_right" android:contentDescription="@string/back" />
    <TextView style="@style/Text" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="@string/expense_categories" android:textSize="34sp"
        android:textStyle="bold" android:accessibilityHeading="true" />
    <TextView android:id="@+id/categoriesEmpty" style="@style/Text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="@string/no_categories"
        android:textSize="14sp" android:textColor="@color/muted" />
    <LinearLayout android:id="@+id/categoryRows" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:orientation="vertical" />
    <TextView android:id="@+id/categoryAdd" style="@style/Text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:minHeight="48dp" android:padding="14dp"
        android:background="@drawable/button_secondary" android:text="@string/add_category"
        android:textColor="@color/text" android:textSize="14sp"
        android:clickable="true" android:focusable="true" />
</LinearLayout>
